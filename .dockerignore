# Only application/build inputs enter an image. Local work and data stay out.
**
!Dockerfile
!requirements-runtime.txt
!streamlit_app.py
!src/
!src/**
!scripts/
!scripts/*.py
!.streamlit/
!.streamlit/config.toml
!static/
!static/fonts/
!static/fonts/**
**/__pycache__/
**/*.pyc
**/*.joblib
**/*.pkl
**/*.pickle
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.sqlite-*
**/*.sqlite3-*
**/*.db-*

**/credentials.json
**/control.sock
