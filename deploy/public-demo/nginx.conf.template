worker_processes 1;
pid /tmp/threatfusion-nginx.pid;
error_log /dev/stderr crit;

events { worker_connections 256; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    client_body_temp_path /tmp/threatfusion-client-body;
    proxy_temp_path /tmp/threatfusion-proxy;
    fastcgi_temp_path /tmp/threatfusion-fastcgi;
    uwsgi_temp_path /tmp/threatfusion-uwsgi;
    scgi_temp_path /tmp/threatfusion-scgi;

    __TRUSTED_PROXIES__

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    limit_req_zone $binary_remote_addr zone=client_requests:1m rate=10r/s;
    limit_req_zone $server_name zone=all_requests:1m rate=50r/s;
    limit_req_zone $binary_remote_addr zone=client_sessions:1m rate=1r/s;
    limit_req_zone $server_name zone=all_sessions:1m rate=5r/s;
    limit_conn_zone $binary_remote_addr zone=client_connections:1m;
    limit_conn_zone $server_name zone=all_connections:1m;
    limit_req_status 429;
    limit_conn_status 429;

    server {
        listen __PORT__;
        client_max_body_size 21m;
        client_body_timeout 30s;
        client_header_timeout 15s;
        keepalive_timeout 30s;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 120s;

        # Health probes must reach Streamlit even when visitor limits are full.
        location = /_stcore/health {
            proxy_pass http://127.0.0.1:8501;
        }

        location / {
            limit_req zone=client_requests burst=50 nodelay;
            limit_req zone=all_requests burst=100 nodelay;
            limit_conn client_connections 12;
            limit_conn all_connections 32;
            proxy_pass http://127.0.0.1:8501;
        }

        location = /_stcore/stream {
            limit_req zone=client_sessions burst=10 nodelay;
            limit_req zone=all_sessions burst=20 nodelay;
            limit_conn client_connections 3;
            limit_conn all_connections 8;
            proxy_pass http://127.0.0.1:8501;
        }
    }
}
